{
  "npmPackage": "@docattest/core-{platform}",
  "platforms": {
    "darwin-arm64": {
      "os": "darwin",
      "cpu": "arm64",
      "rust": "aarch64-apple-darwin",
      "wheel": ["macosx_11_0_arm64"],
      "binary": "docattest"
    },
    "darwin-x64": {
      "os": "darwin",
      "cpu": "x64",
      "rust": "x86_64-apple-darwin",
      "wheel": ["macosx_10_12_x86_64"],
      "binary": "docattest"
    },
    "linux-arm64": {
      "os": "linux",
      "cpu": "arm64",
      "rust": "aarch64-unknown-linux-musl",
      "wheel": ["manylinux_2_17_aarch64", "manylinux2014_aarch64", "musllinux_1_1_aarch64"],
      "binary": "docattest"
    },
    "linux-x64": {
      "os": "linux",
      "cpu": "x64",
      "rust": "x86_64-unknown-linux-musl",
      "wheel": ["manylinux_2_17_x86_64", "manylinux2014_x86_64", "musllinux_1_1_x86_64"],
      "binary": "docattest"
    },
    "windows-x64": {
      "os": "win32",
      "cpu": "x64",
      "rust": "x86_64-pc-windows-msvc",
      "wheel": ["win_amd64"],
      "binary": "docattest.exe"
    }
  }
}
