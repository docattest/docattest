{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docattest adapter protocol, version 1: methods",
  "description": "For each method, the shape of its params and of its result: #/$defs/<method>.params and #/$defs/<method>.result.",
  "$defs": {
    "hello.params": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "number"
        },
        "warm": {
          "type": "boolean"
        }
      },
      "required": ["protocol"],
      "additionalProperties": false
    },
    "hello.result": {
      "$ref": "language.json#/$defs/Hello"
    },
    "docComments.params": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "language.json#/$defs/SourceText"
          }
        }
      },
      "required": ["files"],
      "additionalProperties": false
    },
    "docComments.result": {
      "type": "array",
      "items": {
        "$ref": "attestations.json#/$defs/ExampleAttestation"
      }
    },
    "assertions.params": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            },
            "required": ["lang", "code"],
            "additionalProperties": false
          }
        }
      },
      "required": ["examples"],
      "additionalProperties": false
    },
    "assertions.result": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "docProse.params": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "language.json#/$defs/SourceText"
          }
        }
      },
      "required": ["files"],
      "additionalProperties": false
    },
    "docProse.result": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "language.json#/$defs/DocProse"
        }
      }
    },
    "mentions.params": {
      "type": "object",
      "properties": {
        "spans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["spans", "symbols"],
      "additionalProperties": false
    },
    "mentions.result": {
      "type": "array",
      "items": {
        "type": ["string", "null"]
      }
    },
    "expressions.params": {
      "type": "object",
      "properties": {
        "expressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["expressions"],
      "additionalProperties": false
    },
    "expressions.result": {
      "type": "array",
      "items": {
        "$ref": "language.json#/$defs/ExpressionShape"
      }
    },
    "display.params": {
      "type": "object",
      "properties": {
        "values": {
          "description": "Scalars of the data blocks that facts read with field=, as the block holds them.",
          "type": "array",
          "items": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "required": ["values"],
      "additionalProperties": false
    },
    "display.result": {
      "description": "Each value as the language displays the value it reads that JSON as, in order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open.params": {
      "type": "object",
      "properties": {
        "root": {
          "description": "The project's directory, absolute.",
          "type": "string"
        },
        "files": {
          "description": "Only for a project that exists in memory: every file of it, by path. Then nothing is read from root.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "project.json#/$defs/ConfiguredSurface"
          }
        },
        "setup": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "number"
        },
        "workers": {
          "type": "number"
        },
        "network": {
          "type": "boolean"
        },
        "snapshots": {
          "$ref": "project.json#/$defs/Snapshots"
        },
        "manifests": {
          "$ref": "project.json#/$defs/Manifests"
        },
        "texts": {
          "$ref": "project.json#/$defs/Texts"
        },
        "matches": {
          "$ref": "project.json#/$defs/Matches"
        },
        "manifestFields": {
          "$ref": "project.json#/$defs/ManifestFields"
        },
        "examples": {
          "description": "Every example a compile or run of this session may name: all the well-formed examples of the pages being checked, in page order.",
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/ExampleAttestation"
          }
        }
      },
      "required": [
        "root",
        "surfaces",
        "timeoutMs",
        "workers",
        "network",
        "snapshots",
        "manifests",
        "examples"
      ],
      "additionalProperties": false
    },
    "open.result": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "compile.params": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/ExampleAttestation"
          }
        }
      },
      "required": ["examples"],
      "additionalProperties": false
    },
    "compile.result": {
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/Diagnostic"
      }
    },
    "evaluate.params": {
      "type": "object",
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/FactAttestation"
          }
        }
      },
      "required": ["facts"],
      "additionalProperties": false
    },
    "evaluate.result": {
      "type": "object",
      "additionalProperties": {
        "$ref": "results.json#/$defs/Evaluation"
      }
    },
    "run.params": {
      "type": "object",
      "properties": {
        "examples": {
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/ExampleAttestation"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/CasesAttestation"
          }
        }
      },
      "required": ["examples", "cases"],
      "additionalProperties": false
    },
    "run.result": {
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/Result"
      }
    },
    "symbols.params": {
      "type": "object",
      "properties": {
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "attestations.json#/$defs/Attestation"
          }
        }
      },
      "required": ["attestations"],
      "additionalProperties": false
    },
    "symbols.result": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "results.json#/$defs/SymbolRef"
        }
      }
    },
    "exports.params": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string"
        }
      },
      "required": ["surface"],
      "additionalProperties": false
    },
    "exports.result": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "describeSurfaces.params": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "describeSurfaces.result": {
      "type": "object",
      "additionalProperties": {
        "$ref": "project.json#/$defs/SurfaceDescription"
      }
    },
    "problems.params": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "problems.result": {
      "type": "object",
      "properties": {
        "problems": {
          "description": "Failures that belong to no attestation, each at a file and line of the project.",
          "type": "array",
          "items": {
            "$ref": "results.json#/$defs/Problem"
          }
        },
        "warnings": {
          "description": "Warnings about the whole project, printed with the config's.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["problems", "warnings"],
      "additionalProperties": false
    },
    "tests.params": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        }
      },
      "required": ["file"],
      "additionalProperties": false
    },
    "tests.result": {
      "$ref": "results.json#/$defs/TestListing"
    },
    "runTests.params": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A test a citation names, as its file declares it: the titles that enclose it, outermost first, and its own.",
            "properties": {
              "file": {
                "type": "string"
              },
              "describes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string"
              }
            },
            "required": ["file", "describes", "title"],
            "additionalProperties": false
          }
        },
        "timeoutMs": {
          "description": "How long one run of the test runner may take.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["tests", "timeoutMs"],
      "additionalProperties": false
    },
    "runTests.result": {
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/TestRun"
      }
    },
    "observables.params": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string"
        }
      },
      "required": ["surface"],
      "additionalProperties": false
    },
    "observables.result": {
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/Observable"
      }
    },
    "affected.params": {
      "type": "object",
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["base", "changed"],
      "additionalProperties": false
    },
    "affected.result": {
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/SymbolRef"
      }
    },
    "mutants.params": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "results.json#/$defs/SymbolRef"
          }
        },
        "limit": {
          "description": "The most edits to answer for one symbol.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["symbols", "limit"],
      "additionalProperties": false
    },
    "mutants.result": {
      "description": "One entry for each of the symbols, in their order.",
      "type": "array",
      "items": {
        "$ref": "results.json#/$defs/SymbolMutants"
      }
    },
    "inCode.params": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["names", "files"],
      "additionalProperties": false
    },
    "inCode.result": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "close.params": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "close.result": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}
