{
  "name": "docattest",
  "version": "0.1.3",
  "description": "Documentation that CI can fail: pages carry their own proof, and code links back to the pages that describe it.",
  "keywords": [
    "documentation",
    "docs",
    "doctest",
    "markdown",
    "typescript",
    "testing",
    "ci",
    "drift",
    "docs-as-code",
    "documentation-testing",
    "stale-docs",
    "readme",
    "python",
    "go",
    "rust"
  ],
  "license": "MIT",
  "author": "Matthew Hammond",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docattest/docattest.git",
    "directory": "adapters/typescript"
  },
  "homepage": "https://docattest.github.io/docattest/",
  "bugs": "https://github.com/docattest/docattest/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "docattest": "./dist/launcher/main.js",
    "docattest-adapter-typescript": "./dist/protocol/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/{core-binary,language,launcher,protocol}/**/*.d.{ts,cts}",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ../../protocol/sync.ts dist && npm run chmod",
    "chmod": "node --eval \"for (const f of ['dist/protocol/main.js', 'dist/launcher/main.js']) require('node:fs').chmodSync(f, 0o755)\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node ../../scripts/with-core.ts vitest run",
    "prepublishOnly": "cd ../.. && node scripts/version.ts check && node scripts/release/check-published.ts && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run build:core && npm test && npm run test:docs"
  },
  "optionalDependencies": {
    "@docattest/core-darwin-arm64": "0.1.3",
    "@docattest/core-darwin-x64": "0.1.3",
    "@docattest/core-linux-arm64": "0.1.3",
    "@docattest/core-linux-x64": "0.1.3",
    "@docattest/core-windows-x64": "0.1.3"
  },
  "peerDependencies": {
    "typescript": ">=5.4 <7"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
