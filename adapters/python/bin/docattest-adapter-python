#!/usr/bin/env python3
"""Run the adapter from a checkout, without installing it:

    DOCATTEST_ADAPTER_PYTHON="python3 /path/to/adapters/python/bin/docattest-adapter-python"
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from docattest_python.server.server import main  # noqa: E402

main()
